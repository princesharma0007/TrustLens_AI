# Sample environment variables for TrustLens AI backend
# Do NOT commit this file with real values.
PORT=3000
# Optional Gemma 4 API key – leave empty if not configured
GEMMA_API_KEY=

# Optional adapter URL accepting POST {message} and returning a structured report.
# Both URL and key are required to use Gemma; leave blank for local rules.
GEMMA_API_URL=
# Explicitly opt in to rule-based fallback if configured Gemma fails.
GEMMA_FALLBACK_ENABLED=false

# Optional Google Web Risk Lookup API. Explicit opt-in sends submitted URLs
# (including paths/queries) to Google. Never paste a real key in this file.
URL_REPUTATION_ENABLED=false
GOOGLE_WEB_RISK_API_KEY=
